# Read by dev.sh. Keep exactly one DATABASE_URL line uncommented, then restart ./dev.sh.

# Postgres (this app's database): run `docker compose up -d` first
DATABASE_URL=postgresql://app:app@localhost:5432/app

# SQLite: not supported yet, backend/app/schema/sqlite.sql still holds the starter's demo table
# DATABASE_URL=sqlite:///app.db

# xAI key for story generation (https://console.x.ai). Never commit the real one.
XAI_API_KEY=
